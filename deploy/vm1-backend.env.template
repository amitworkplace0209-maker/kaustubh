# ============================================================================
# KDS VM1 — production backend environment template
#
# Deploy to /etc/kds/backend.env on VM1 (private IP 10.1.1.133).
# Owner: root, mode 0600. NEVER commit to Git.
# Fill in every value marked <REPLACE> before starting the service.
# ============================================================================

# ---------------------------------------------------------------- MongoDB
# Connects to VM2 (10.1.2.178) on port 27017, database `kds`,
# authenticating as user `poo` against the `admin` database.
# Percent-encode any special characters in the password (e.g. @ % : /).
# Format: mongodb://<user>:<password>@<host>:27017/<db>?authSource=admin
MONGODB_URI=mongodb://poo:<REPLACE_PASSWORD>@10.1.2.178:27017/kds?authSource=admin
MONGODB_DATABASE=kds

# Test database (optional, for integration tests only — never production).
# MONGODB_TEST_URI=
# MONGODB_TEST_DATABASE=kds_test

# ---------------------------------------------------------------- Service
# Bind only to the private VCN address. This keeps the API off the public
# interface — only VM1 itself and VM2 can reach port 8000. Do NOT open 8000
# in the OCI security list or host firewall.
HOST=10.1.1.133
PORT=8000
LOG_LEVEL=info

# ---------------------------------------------------------------- CORS
# Backend CORS allowlist. Set to the actual Vercel production origin(s).
# Never use `*` with `allow_credentials=True` (FastAPI will refuse to start).
# Example: https://kds.vercel.app,https://kds-preview.vercel.app
CORS_ORIGINS=<REPLACE_VERCEL_ORIGIN>

# ---------------------------------------------------------------- App / JWT auth
# Trading terminal authentication (user-level, independent of broker login).
# Backend-only secrets. Never expose to browser.
APP_USERNAME=<REPLACE_USERNAME>
APP_PASSWORD=<REPLACE_PASSWORD>
JWT_SECRET=<REPLACE_JWT_SECRET>
# Generate locally:  openssl rand -hex 48
JWT_ISSUER=kaustubh-backend
JWT_AUDIENCE=kaustubh-terminal
JWT_TTL_SECONDS=28800

# ---------------------------------------------------------------- Broker mode
# Keep dummy for deployment verification. Never enable live broker modes
# without explicit operator approval.
BROKER_MODE=dummy
KOTAK_ENABLED=false
SHOONYA_ENABLED=0

# Kotak Neo SDK credentials (backend secrets). Only needed if BROKER_MODE=kotak
# and KOTAK_ENABLED=true. Leave empty during verification.
# CLIENT_ID=
# CONSUMER_KEY=
# CONSUMER_SECRET=
# MOBILE_NUMBER=
# MPIN=
# TOTP_SECRET=

# Shoonya OAuth credentials (backend secrets). Only needed if SHOONYA_ENABLED=1.
# Leave empty during verification.
# SHOONYA_API_KEY=
# SHOONYA_SECRET_KEY=
# SHOONYA_USER_ID=
# SHOONYA_ACCOUNT_ID=
# SHOONYA_REDIRECT_URL=
# SHOONYA_HOST=https://api.shoonya.com/NorenWClientTP/
# SHOONYA_WEBSOCKET=wss://api.shoonya.com/NorenWSTP/

# ---------------------------------------------------------------- VM monitoring / agents
# Per-VM agent tokens. Must match /etc/kds/agent-token on each VM.
# Generate each independently:  openssl rand -hex 32
# Never print, never commit, never paste into chat.
VM_AGENT_TOKEN_VM1=<REPLACE_VM1_TOKEN>
VM_AGENT_TOKEN_VM2=<REPLACE_VM2_TOKEN>

# Freshness gates (seconds).
VM_STALE_SECONDS=180
VM_DISCONNECTED_SECONDS=600
VM_HISTORY_RETENTION_DAYS=14
VM_EVENT_RETENTION_DAYS=30

# Thresholds.
VM_CPU_WARN_PCT=85
VM_CPU_CRITICAL_PCT=95
VM_CPU_WARN_SUSTAIN_SECONDS=300
VM_CPU_CRITICAL_SUSTAIN_SECONDS=600
VM_RAM_WARN_AVAILABLE_PCT=15
VM_RAM_CRITICAL_AVAILABLE_PCT=8
VM_RAM_SUSTAIN_SECONDS=120
VM_DISK_WARN_PCT=80
VM_DISK_CRITICAL_PCT=90
VM_INODE_WARN_PCT=80
VM_INODE_CRITICAL_PCT=90
VM_BACKUP_MAX_AGE_HOURS=30

# Automatic recovery: ON by default, narrow (allowlisted units only).
VM_AUTO_RECOVERY_ENABLED=true
VM_RECOVERY_ALLOWLIST=kds-backend,mongod
VM_RECOVERY_COOLDOWN_SECONDS=600
VM_RECOVERY_MAX_PER_INCIDENT=2
VM_RECOVERY_MAX_PER_HOUR=2

# ---------------------------------------------------------------- Scheduler (IST)
# Market schedule per requirement: login ~09:00, WS connect/subscribe 09:13,
# disconnect 15:31 on trading days. Session login and WS connection are
# separate scheduled events.
LOGIN_HOUR=9
LOGIN_MINUTE=0
LOGOUT_HOUR=16
LOGOUT_MINUTE=0
WS_START_HOUR=9
WS_START_MINUTE=13
WS_STOP_HOUR=15
WS_STOP_MINUTE=31

# Tick collection (IST).
TICK_COLLECTION_HOUR=9
TICK_COLLECTION_MINUTE=59

# ---------------------------------------------------------------- SDK
NEO_ENVIRONMENT=prod

# ---------------------------------------------------------------- Timeouts (seconds)
BROKER_LOGIN_TIMEOUT=30
BROKER_API_TIMEOUT=20
WS_CONNECT_TIMEOUT=20
HTTP_REQUEST_TIMEOUT=15
HEALTH_CHECK_TIMEOUT=5

# ---------------------------------------------------------------- WebSocket reconnect
WS_RECONNECT_INITIAL_DELAY=1.0
WS_RECONNECT_MAX_DELAY=60.0
WS_RECONNECT_MAX_ATTEMPTS=0
WS_HEARTBEAT_TIMEOUT_SEC=30
WS_HEARTBEAT_INTERVAL_SEC=5

# ---------------------------------------------------------------- Tick buffer
BUFFER_FLUSH_INTERVAL_MS=1000
BUFFER_MAX_SIZE=5000
BULK_INSERT_SIZE=1000

# ---------------------------------------------------------------- TOTP
TOTP_ISSUER=kotakneo.com

# ============================================================================
# Installation notes for VM1
# ============================================================================
# 1. Copy this file to /etc/kds/backend.env
# 2. chmod 600 /etc/kds/backend.env; chown root:root /etc/kds/backend.env
# 3. Replace every <REPLACE_*> value with real data (no secrets in git)
# 4. Create the systemd service from deploy/kds-backend.service
# 5. systemctl daemon-reload && systemctl enable --now kds-backend
# 6. Verify: curl -fsS http://10.1.1.133:8000/api/system/health
# ============================================================================
