# =========================================================
# KAUSTUBH backend — environment template
# Copy to .env (DO NOT commit) and fill in real values.
# Every secret is backend-only; nothing here is safe to commit.
# =========================================================

# ---- Kotak Neo SDK credentials (backend secrets) ----
# Are all empty. Fill the real values ONLY in .env / .env.local.
#
#   CLIENT_ID        the Kotak "ucc" (user client code) used by the TOTP login
#   CONSUMER_KEY     the consumer key of the API key pair
#   CONSUMER_SECRET  the consumer secret (never leaves the backend)
#   MOBILE_NUMBER    the registered mobile number (the OTP goes there)
#   MPIN             the 4-digit market MPIN (the trade-token validation)
#   TOTP_SECRET      the base32 TOTP seed from "Net / Trade > Enable TOTP"
#
# The AUTO-LOGIN is complete for Kotak: the backend generates the TOTP from
# TOTP_SECRET, calls totp_login + totp_validate (MPIN) and holds the session.
# It runs at STARTUP and after every TERMINAL SWITCH — no browser, no human.
CLIENT_ID=
CONSUMER_KEY=
CONSUMER_SECRET=
MOBILE_NUMBER=
MPIN=
TOTP_SECRET=

# ---- Shoonya (NorenRestApiOAuth 0.0.41) OAuth credentials (backend secrets) ----
#
# WHAT EACH VALUE IS (all of them come from the Shoonya "My Account > API Key"
# page in the Shoonya app, or from the Shoonya business team):
#
#   SHOONYA_API_KEY      the "API Key" (client_id). It is sent as
#                        ?client_id=... in the OAuth URL AND as the
#                        `client_id` when the auth code is exchanged.
#                        Shape: a short alphanumeric string (~16-32 chars).
#   SHOONYA_SECRET_KEY   the "Secret Key" of the same API-key pair. It is
#                        NEVER sent to the browser — it only signs the
#                        code->token exchange.
#                        Shape: a longer alphanumeric string.
#   SHOONYA_USER_ID      your Shoonya "User ID" (also called the client
#                        code / UID). It identifies the account.
#                        Shape: e.g. FA123456 (or a numeric UID).
#   SHOONYA_ACCOUNT_ID   the trading account id (actid). It is usually the
#                        SAME string as SHOONYA_USER_ID, but Shoonya returns
#                        it from the token exchange — the backend stores the
#                        returned one, so this is only the fallback.
#   SHOONYA_REDIRECT_URL where Shoonya sends the browser back after you
#                        approve the app. It must be registered in the
#                        Shoonya API-key page AND reachable from the phone.
#   SHOONYA_HOST         the Noren REST host (the SDK's default is
#                        https://api.shoonya.com/NorenWClientTP/).
#   SHOONYA_WEBSOCKET    the Noren market/order feed
#                        (wss://api.shoonya.com/NorenWSTP/).
#
# HOW THE SHOONYA LOGIN WORKS (there is NO password login in this SDK):
#   1. the backend builds the OAuth URL and the UI opens it;
#   2. you approve the app in the browser; Shoonya redirects to
#      SHOONYA_REDIRECT_URL with a short-lived code;
#   3. the browser hands the code to the backend
#      (POST /api/terminal/oauth-code) and the backend exchanges it for the
#      bearer token;
#   4. the token is stored ENCRYPTED (runtime/terminal_credentials.json) —
#      from then on every restart and every terminal switch restores the
#      session AUTOMATICALLY. You only do steps 1-3 once.
#
# Set SHOONYA_ENABLED=1 only after the SDK is installed and the secrets are
# filled in. With it off, the Shoonya terminal reports "not enabled" and the
# Kotak / Dummy terminals are unaffected.
SHOONYA_ENABLED=0
SHOONYA_API_KEY=
SHOONYA_SECRET_KEY=
SHOONYA_USER_ID=
SHOONYA_ACCOUNT_ID=
SHOONYA_REDIRECT_URL=http://localhost:3000/trading/shoonya-oauth
SHOONYA_HOST=https://api.shoonya.com/NorenWClientTP/
SHOONYA_WEBSOCKET=wss://api.shoonya.com/NorenWSTP/

# ---- Terminal auto-login (all brokers) ----
# Every terminal obtains its own session the only way it can:
#   kotak   -> TOTP + MPIN (the secrets above)            : fully automatic
#   dummy   -> managed paper session                       : fully automatic
#   shoonya -> OAuth; the first session needs the browser, after that the
#              stored (encrypted) token is restored        : automatic
# The backend runs the auto-login at STARTUP and after every TERMINAL SWITCH.
# A failed auto-login never blocks the app — the terminal simply reports
# "not connected" until the operator acts.
# TERMINAL_CREDENTIAL_KEY — optional. A base64 Fernet key (32 urlsafe bytes)
#   that encrypts the stored broker session material. Without it the key is
#   derived from JWT_SECRET, and without that a key file is generated once
#   under runtime/ (owner-only, git-ignored).
# TERMINAL_CREDENTIAL_KEY=

# ---- App / JWT auth (backend secrets) ----
APPLICATION_USERNAME=
APP_USERNAME=
APP_PASSWORD=
JWT_SECRET=
JWT_ISSUER=kaustubh-backend
JWT_AUDIENCE=kaustubh-terminal
JWT_TTL_SECONDS=28800

# ---- MongoDB (required) ----
# MONGODB_URI is REQUIRED. It controls the database destination:
#   mongodb://127.0.0.1:27017/kaustubh        -> Local MongoDB (development only)
#   mongodb://localhost:27017/kaustubh        -> Local MongoDB (development only)
#   mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/kaustubh  -> MongoDB Atlas (PRIMARY)
#   mongodb://<vm-ip>:27017/kaustubh          -> MongoDB VM (ALTERNATIVE)
# The URI decides the destination; the application code does not care.
# Backend-only secret. Never commit the real value, never expose it to the
# frontend, never print it in logs (only a redacted host is logged).
# Example (Atlas): MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kaustubh?retryWrites=true&w=majority
# Example (VM):    MONGODB_URI=mongodb://<vm-ip>:27017/kaustubh
# Example (Local): MONGODB_URI=mongodb://127.0.0.1:27017/kaustubh
MONGODB_URI=
MONGODB_DATABASE=kaustubh

# Test database (optional) — used by integration tests to avoid touching
# the production database. If not set, tests that need MongoDB will use
# the main MONGODB_URI (or skip if unavailable).
# Example (Atlas): MONGODB_TEST_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kaustubh_test?retryWrites=true&w=majority
# Example (VM):    MONGODB_TEST_URI=mongodb://<vm-ip>:27017/kaustubh_test
# Example (Local): MONGODB_TEST_URI=mongodb://127.0.0.1:27017/kaustubh_test
MONGODB_TEST_URI=
MONGODB_TEST_DATABASE=kaustubh_test

# Atlas/VM connection pool / timeouts (optional tuning).
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=15000
# MONGODB_CONNECT_TIMEOUT_MS=15000
# MONGODB_SOCKET_TIMEOUT_MS=45000
# MONGODB_MAX_POOL_SIZE=50
# MONGODB_MIN_POOL_SIZE=5
# MONGODB_MAX_IDLE_TIME_MS=120000
# MONGODB_WAIT_QUEUE_TIMEOUT_MS=10000
# MONGODB_CONNECT_ATTEMPTS=3
# MONGODB_CONNECT_RETRY_DELAY_S=2.0

# ---- Atlas daily cleanup (06:00 Asia/Kolkata) ----
# Wipes temporary market data (ticks, candles, telemetry, ws history, scan
# points, app logs). Config, history summaries and reports are preserved.
ATLAS_CLEANUP_ENABLED=1
ATLAS_CLEANUP_HOUR=6
ATLAS_CLEANUP_MINUTE=0

# ---- Storage guard + auto-cleanup at % full ----
# Real usage is read from dbStats. "90% full" is measured against
# STORAGE_CAPACITY_MB (Atlas M0 free tier = 512). At/beyond the threshold the
# guard auto-runs the safe cleanup pass every check interval (5 min default).
# STORAGE_GUARD_ENABLED=1
# STORAGE_BUDGET_MB=300
# STORAGE_GUARD_INTERVAL_SEC=300
# STORAGE_CAPACITY_MB=512
# STORAGE_AUTOCLEAN_PCT=90

# ---- Service ----
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# ---- CORS ----
CORS_ORIGINS=*

# ---- Broker mode selection: kotak | shoonya | dummy ----
BROKER_MODE=kotak

# ---- Scheduler (IST) ----
LOGIN_HOUR=8
LOGIN_MINUTE=50
LOGOUT_HOUR=16
LOGOUT_MINUTE=0
WS_START_HOUR=8
WS_START_MINUTE=55
WS_STOP_HOUR=15
WS_STOP_MINUTE=31

# ---- SDK ----
NEO_ENVIRONMENT=prod

# ---- Broker operation timeouts (seconds) ----
BROKER_LOGIN_TIMEOUT=30
BROKER_API_TIMEOUT=20
WS_CONNECT_TIMEOUT=20
HTTP_REQUEST_TIMEOUT=15
HEALTH_CHECK_TIMEOUT=5

# ---- WebSocket Reconnect ----
WS_RECONNECT_INITIAL_DELAY=1.0
WS_RECONNECT_MAX_DELAY=60.0
WS_RECONNECT_MAX_ATTEMPTS=0
WS_HEARTBEAT_TIMEOUT_SEC=30
WS_HEARTBEAT_INTERVAL_SEC=5

# ---- Tick Buffer ----
BUFFER_FLUSH_INTERVAL_MS=1000
BUFFER_MAX_SIZE=5000
BULK_INSERT_SIZE=1000

# ---- TOTP ----
TOTP_ISSUER=kotakneo.com

# ---- VM monitoring / agents (backend-only) ----
# The VM pages read these values from MongoDB through the API below; the
# browser never receives an agent token.
#
# Agent tokens: one long random secret PER VM. Generate each independently:
#   openssl rand -hex 32
# Put the same value in this backend env and in the agent's token file
# (/etc/kds/agent-token, mode 0640 root:kds-agent). Never commit the value,
# never paste it into chat, never put it in the Next.js env.
# With a token empty, that VM's heartbeat endpoint rejects every request
# (503) and the UI shows the VM as DISCONNECTED — no fake data.
VM_AGENT_TOKEN_VM1=
VM_AGENT_TOKEN_VM2=
#
# Freshness gates. A sample older than VM_STALE_SECONDS is shown as STALE; the
# agent is DISCONNECTED after VM_DISCONNECTED_SECONDS. Nothing is invented.
VM_STALE_SECONDS=180
VM_DISCONNECTED_SECONDS=600
#
# Retention (MongoDB TTL indexes). Samples are small; 14 days is plenty.
VM_HISTORY_RETENTION_DAYS=14
VM_EVENT_RETENTION_DAYS=30
#
# Thresholds. CPU checks a sustained average, not a single spike.
# RAM is measured as AVAILABLE percent (higher is better), so the warn/critical
# values are LOW-water marks.
VM_CPU_WARN_PCT=85
VM_CPU_CRITICAL_PCT=95
VM_CPU_WARN_SUSTAIN_SECONDS=300
VM_CPU_CRITICAL_SUSTAIN_SECONDS=600
VM_RAM_WARN_AVAILABLE_PCT=15
VM_RAM_CRITICAL_AVAILABLE_PCT=8
VM_RAM_SUSTAIN_SECONDS=120
VM_DISK_WARN_PCT=80
VM_DISK_CRITICAL_PCT=90
VM_INODE_WARN_PCT=80
VM_INODE_CRITICAL_PCT=90
# A backup older than this many hours is reported as overdue. If no backup
# exists the UI reports NOT_CONFIGURED — it never claims a backup happened.
VM_BACKUP_MAX_AGE_HOURS=30
#
# Automatic recovery. ON by default, deliberately narrow:
#   * only units in VM_RECOVERY_ALLOWLIST,
#   * only after a confirmed service failure (not a busy host),
#   * never a VM reboot, never firewall/database/network changes,
#   * max VM_RECOVERY_MAX_PER_INCIDENT restarts per incident,
#   * max VM_RECOVERY_MAX_PER_HOUR restarts per unit,
#   * at least VM_RECOVERY_COOLDOWN_SECONDS between attempts.
# Set VM_AUTO_RECOVERY_ENABLED=false to require a human for every restart.
VM_AUTO_RECOVERY_ENABLED=true
VM_RECOVERY_ALLOWLIST=kds-backend,mongod
VM_RECOVERY_COOLDOWN_SECONDS=600
VM_RECOVERY_MAX_PER_INCIDENT=2
VM_RECOVERY_MAX_PER_HOUR=2
