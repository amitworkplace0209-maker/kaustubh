# ---- Kotak Neo SDK Credentials (required) ----
CLIENT_ID=your_client_id
CONSUMER_KEY=your_consumer_key
CONSUMER_SECRET=your_consumer_secret
MOBILE_NUMBER=your_mobile_number
MPIN=your_mpin
TOTP_SECRET=your_totp_secret

# ---- MongoDB (required) ----
MONGODB_URI=mongodb://localhost:27017/kaustubh
MONGODB_DATABASE=kaustubh

# ---- Service ----
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# ---- CORS ----
CORS_ORIGINS=*

# ---- Scheduler (IST) ----
LOGIN_HOUR=9
LOGIN_MINUTE=0
LOGOUT_HOUR=15
LOGOUT_MINUTE=35

# ---- SDK ----
NEO_ENVIRONMENT=prod

# ---- WebSocket Reconnect ----
WS_RECONNECT_INITIAL_DELAY=1.0
WS_RECONNECT_MAX_DELAY=60.0
WS_RECONNECT_MAX_ATTEMPTS=0
WS_HEARTBEAT_TIMEOUT_SEC=30
WS_HEARTBEAT_INTERVAL_SEC=5

# ---- Tick Buffer ----
BUFFER_FLUSH_INTERVAL_MS=1000
BUFFER_MAX_SIZE=5000
BULK_INSERT_SIZE=1000

# ---- TOTP ----
TOTP_ISSUER=kotakneo.com
