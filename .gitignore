# ==========================
# Local backup files
# ==========================
*.backup
*.before-*

# Local service/debug files
# These directories contain application code that must be tracked for
# reproducible deployment. Only runtime state files inside are ignored.
!python-service/services/status/
!python-service/runtime/
python-service/services/status/__pycache__/
python-service/runtime/__pycache__/
python-service/runtime/backend.pid
python-service/runtime/backend.state
python-service/runtime/degraded.txt
python-service/runtime/backend-singleton-*.lock
python-service/runtime/*.log
python-service/runtime/*.err
*.backup2

# ==========================
# Secrets & credentials (never commit)
# ==========================
# Every env file except the committed templates.
.env.*
!.env.example
!.env.sample
!**/.env.example
!**/.env.sample

# SSH / TLS / cloud keys and provisioning material.
*.key
*.pem
*.ppk
*.p12
*.pfx
id_rsa*
id_ed25519*
id_ecdsa*
known_hosts

# VM agent runtime config, tokens and local state.
agents/*.env
agents/secrets/
agents/state/
kds-agent.json
agent-token

# Database dumps and archives (contain production data).
*.dump
*.bson
*.archive
dump/
dump-*/
mongodump-*/
backups/
python-service/backups/
db-backups/
