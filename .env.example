# ============================================================================
# KAUSTUBH — example environment
# Copy to `.env.local` (dev) or set these in the VM/systemd environment.
# NEVER commit real secrets. `.env*` files are git-ignored.
#
# Every auth value below is SERVER-ONLY. Do not prefix any of them with
# NEXT_PUBLIC_ — anything public is inlined into the browser bundle and would
# expose the backend/database configuration.
# ============================================================================

# ---------------------------------------------------------------- MongoDB
# Atlas now, a fresh VM-hosted MongoDB later. AUTH_MONGODB_URI wins; MONGODB_URI
# is shared with the Python service.
AUTH_MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/?retryWrites=true&w=majority
AUTH_MONGODB_DB=kaustubh
# If SRV DNS is blocked on the host, the resolver falls back to 8.8.8.8/1.1.1.1.
# (The auth layer also accepts plain mongodb:// connection strings.)

# ------------------------------------------------------- one-time signup
# The signup screen appears ONLY until the first owner exists. These two values
# are the proof that the person signing up controls the server:
#   • email must match exactly (case-insensitive)
#   • MPIN must match exactly (6 digits)
# They are intentionally NOT stored in MongoDB. Only the owner's name and a
# scrypt password hash are saved. Once the owner exists, signup is closed.
AUTH_SIGNUP_EMAIL=owner@example.com
AUTH_SIGNUP_MPIN=123456

# ------------------------------------------------------------- sessions
# HMAC secret for the `kaustubh_session` cookie. Use 48+ random bytes.
# If omitted, `.auth/session-secret` is generated once (mode 0600) and reused.
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
# 2 = one web/PWA login + one second device. Clamped to 1..2.
AUTH_MAX_ACTIVE_SESSIONS=2

# ------------------------------------------------------ OTP email delivery
# A second device always requires a fresh 6-digit code. Configure EITHER SMTP
# or a webhook. In development, with no channel configured, the code is shown
# in the UI and the server log (never in production).
AUTH_SMTP_HOST=smtp.example.com
AUTH_SMTP_PORT=587
AUTH_SMTP_SECURE=false
AUTH_SMTP_USER=owner@example.com
AUTH_SMTP_PASS=replace-me
AUTH_EMAIL_FROM="KAUSTUBH Security <owner@example.com>"
AUTH_EMAIL_TO=owner@example.com

# Optional generic webhook (POST JSON: { to, subject, text, html, otp }).
# AUTH_OTP_WEBHOOK_URL=https://hooks.example.com/otp

# Only honoured outside production. Set false to disable the console fallback.
AUTH_OTP_DEV_FALLBACK=false

# ---------------------------------------------------------- WebAuthn
# Real fingerprint / face unlock. Needs a domain name or localhost — bare IPs
# cannot be a relying-party ID. On a VM put the app behind a domain + HTTPS.
# AUTH_RP_ID=terminal.example.com
# AUTH_ORIGIN=https://terminal.example.com
AUTH_RP_NAME=KAUSTUBH Trading Platform

# ------------------------------------------------------ Python backend
# SERVER-ONLY. The browser never sees this origin: Next rewrites `/api/*` and
# `server.mjs` tunnels `/ws/*`. Leave unset for a local all-in-one VM.
# BACKEND_URL=http://127.0.0.1:8000
# WS_BACKEND_URL=http://127.0.0.1:8000

# ------------------------------------------------------- VM monitoring
# The VM agent tokens (VM_AGENT_TOKEN_VM1 / VM_AGENT_TOKEN_VM2) belong ONLY in
# `python-service/.env` on the backend host and in each agent's
# /etc/kds/agent-token file. They must never appear here, in `.env.local`, in
# a NEXT_PUBLIC_* variable, or in the repository. See docs/VM_MANAGEMENT.md.

# The Python service shares the database for market data/settings.
# MONGODB_URI=mongodb://127.0.0.1:27017
# MONGODB_DB=kaustubh

# ------------------------------------------------- legacy (optional)
# Older installer/health probes still read these; they are NOT used by the
# single-owner auth flow. Leave empty unless you have a reason.
APP_LOCK_PIN=
GUEST_EMAIL=
GUEST_PASSWORD=
