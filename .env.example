# ============================================
# KAUSTUBH Trading Platform â€” Frontend Config
# ============================================
# Copy to .env.local and configure.
# NEVER use NEXT_PUBLIC_ prefix for secrets.

# ---- Backend API ----
# Base URL of the FastAPI python-service
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# ---- Realtime WebSocket (backend <=> browser) ----
# URL of the backend's /ws/realtime socket. The UI receives snapshots for
# trading/state channels over THIS socket instead of polling REST.
#
# LOCAL (custom Next server tunnels /ws/* to the backend):
#   leave empty -> the browser connects to same-origin ws(s)://<host>/ws/realtime
#   and `server.mjs` proxies the raw socket to the FastAPI backend.
#
# VERCEL (serverless cannot hold sockets) or any remote deployment:
#   point this at a WS-capable host that runs python-service
#   (Railway / Render / Fly / VM), e.g.
#     NEXT_PUBLIC_WS_URL=wss://kaustubh-backend.up.railway.app/ws/realtime
#   The host only needs the FastAPI app with its WS gateway exposed.
NEXT_PUBLIC_WS_URL=

# ---- App Lock PIN (optional) ----
# If set, used as bootstrap PIN for first login.
# After first setup, hashed PIN is stored in .auth/app-lock.json
# and this value is no longer needed.
APP_LOCK_PIN=

# ---- Guest credentials (optional, server-side only) ----
GUEST_EMAIL=
GUEST_PASSWORD=
