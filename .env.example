# ============================================================================
# KAUSTUBH — example environment (frontend / Next.js)
#
# Copy to `.env.local` (development) or set these in your production host
# (systemd environment file / Vercel project settings).
# NEVER commit real secrets. `.env*` files are git-ignored except this template.
#
# SERVER-ONLY variables: never prefix with NEXT_PUBLIC_ — anything public is
# inlined into the browser bundle and would expose backend/database config.
# Browser-visible variables (NEXT_PUBLIC_*) are listed separately below.
# ============================================================================

# ---------------------------------------------------------------- MongoDB (VM1 only)
# The owner-auth database is read ONLY by the FastAPI backend on VM1. The
# Vercel frontend proxies `/api/auth/*` to VM1 and must NOT receive this URI.
# Example (VM):  mongodb://127.0.0.1:27017/kaustubh?authSource=admin
# Example (Atlas): mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/kaustubh?retryWrites=true&w=majority
AUTH_MONGODB_URI=mongodb://127.0.0.1:27017/kaustubh?authSource=admin
AUTH_MONGODB_DB=kaustubh

# ------------------------------------------------------- one-time signup (VM1 only)
# The signup screen appears ONLY until the first owner exists. These two values
# are the proof that the person signing up controls the server:
#   • email must match exactly (case-insensitive)
#   • MPIN must match exactly (6 digits)
# They are intentionally NOT stored in MongoDB. Only the owner's name and a
# scrypt password hash are saved. Once the owner exists, signup is closed.
AUTH_SIGNUP_EMAIL=owner@example.com
AUTH_SIGNUP_MPIN=123456

# ------------------------------------------------------------- sessions (VM1 only)
# HMAC secret for the `kaustubh_session` cookie, verified by the VM1 backend on
# every session-gated call. The Vercel proxy only reads the session id and asks
# VM1 whether it is live, so this secret is NOT required on Vercel.
# Generate locally:  openssl rand -hex 48
# If omitted on VM1, `.auth/session-secret` is generated once (mode 0600).
AUTH_SESSION_SECRET=replace-with-at-least-96-hex-characters
# 2 = one web/PWA login + one second device. Clamped to 1..2.
AUTH_MAX_ACTIVE_SESSIONS=2

# ------------------------------------------------------ OTP email delivery (VM1 only)
# A second device always requires a fresh 6-digit code. Configure EITHER SMTP
# or a webhook. In development, with no channel configured, the code is shown
# in the UI and the server log (never in production).
AUTH_SMTP_HOST=smtp.example.com
AUTH_SMTP_PORT=587
AUTH_SMTP_SECURE=false
AUTH_SMTP_USER=owner@example.com
AUTH_SMTP_PASS=replace-me
AUTH_EMAIL_FROM="KAUSTUBH Security <owner@example.com>"
AUTH_EMAIL_TO=owner@example.com

# Optional generic webhook (POST JSON: { to, subject, text, html, otp }).
# AUTH_OTP_WEBHOOK_URL=https://hooks.example.com/otp

# Only honoured outside production. Set false to disable the console fallback.
AUTH_OTP_DEV_FALLBACK=false

# ------------------------------------------------------ WebAuthn (frontend)
# Real fingerprint / face unlock. Needs a domain name or localhost — bare IPs
# cannot be a relying-party ID. On a VM put the app behind a domain + HTTPS.
# These three are non-secret config and are required on Vercel ONLY if you use
# biometrics; the cryptographic verification runs in the Next Node layer while
# credentials/challenges are stored by VM1.
# AUTH_RP_ID=terminal.example.com
# AUTH_ORIGIN=https://terminal.example.com
AUTH_RP_NAME=KAUSTUBH Trading Platform

# ------------------------------------------------------ Python backend
# SERVER-ONLY. The browser never sees this origin: Next rewrites `/api/*` and
# `server.mjs` tunnels `/ws/*`. Leave unset for a local all-in-one VM.
# On VM1 (private network):  http://10.1.1.133:8000
# BACKEND_URL=http://127.0.0.1:8000
# WS_BACKEND_URL=http://127.0.0.1:8000

# The backend binds to HOST (default 0.0.0.0) — production VM1 should set
# HOST=10.1.1.133 in its own env file (`/etc/kds/backend.env`), not here.

# ------------------------------------------------------- VM monitoring
# The VM agent tokens (VM_AGENT_TOKEN_VM1 / VM_AGENT_TOKEN_VM2) belong ONLY in
# `python-service/.env` on the backend host and in each agent's
# /etc/kds/agent-token file. They must never appear here, in `.env.local`, in
# a NEXT_PUBLIC_* variable, or in the repository. See docs/VM_MANAGEMENT.md.

# ------------------------------------------------------- CORS (backend)
# Backend-only. The Python FastAPI CORS allowlist. In production set this to
# the actual Vercel origin(s), e.g. https://kds.example.com. Never use `*`
# with credentials enabled.
# CORS_ORIGINS=https://kds.example.com,https://preview-kds.example.com

# ------------------------------------------------------- Scheduler (IST)
# Backend-only. Market schedule for the Python backend. Requirement:
#   login ~09:00, WS connect/subscribe 09:13, disconnect 15:31 on trading days.
# These are read by `python-service/config/settings.py`.
# LOGIN_HOUR=9
# LOGIN_MINUTE=0
# WS_START_HOUR=9
# WS_START_MINUTE=13
# WS_STOP_HOUR=15
# WS_STOP_MINUTE=31

# ------------------------------------------------------ Broker mode (backend)
# Backend-only. Keep `dummy` for deployment verification. Never enable live
# broker modes (kotak/shoonya) without explicit operator approval.
# BROKER_MODE=dummy
# KOTAK_ENABLED=false
# SHOONYA_ENABLED=0

# ------------------------------------------------------ Legacy (optional)
# Older installer/health probes still read these; they are NOT used by the
# single-owner auth flow. Leave empty unless you have a reason.
APP_LOCK_PIN=
GUEST_EMAIL=
GUEST_PASSWORD=

# ============================================================================
# Browser-visible variables (Vercel / frontend)
# ============================================================================
# Only these are safe to expose to the browser. Everything else stays
# server-only.

# Public API base (same-origin in browser, empty by default). Set only if you
# need an explicit absolute origin for browser-side fetch calls.
# NEXT_PUBLIC_API_BASE=

# Public WebSocket URL. Set this ONLY on serverless hosts (Vercel) to the
# full public tunnel endpoint, e.g.:
#   NEXT_PUBLIC_WS_URL=wss://<tunnel-host>/ws/realtime
# The browser then connects directly to the backend gateway (which still
# requires a short-lived ?token=). Leave unset for local/self-hosted deploys:
# the browser uses same-origin /ws/realtime and server.mjs tunnels it.
# NEXT_PUBLIC_WS_URL=

# ============================================================================
# Notes for Vercel
# ============================================================================
# 1. Vercel runs Next.js serverless functions — the custom `server.mjs` (with
#    its WS proxy) cannot run there. Set NEXT_PUBLIC_WS_URL to the public
#    tunnel's `wss://.../ws/realtime` to keep realtime; otherwise REST polling.
# 2. On Vercel the ONLY required server variable is BACKEND_URL (the public
#    HTTPS URL of VM1). MongoDB/auth/OTP/APP_PASSWORD secrets stay on VM1 in
#    /etc/kds/backend.env. Optional: AUTH_RP_ID/AUTH_ORIGIN/AUTH_RP_NAME.
# 3. The backend must be reachable over HTTPS from Vercel. VM1's port 8000 is
#    on the private network only — a reverse proxy + TLS (or a public HTTPS
#    endpoint) is required before Vercel can call it.
# 4. CORS on the backend must include the Vercel production origin.
